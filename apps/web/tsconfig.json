{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "vite-plugin-pwa/client", "node"],
    "allowJs": false,
    "paths": {
      "@steptrack/core": ["../../packages/core/src/index.ts"],
      "@steptrack/core/*": ["../../packages/core/src/*"],
      "@/*": ["../../packages/core/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "e2e/**/*.ts",
    "vite.config.ts",
    "capacitor.config.ts",
    "playwright.config.ts",
    "scripts/*.d.mts",
    "../../packages/core/src/env.d.ts"
  ]
}
