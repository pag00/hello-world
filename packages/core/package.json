{
  "name": "@steptrack/core",
  "version": "0.1.0",
  "description": "Procedure authoring & execution (AS9100) — Vue 3 library",
  "type": "module",
  "main": "./dist/steptrack-core.js",
  "module": "./dist/steptrack-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/steptrack-core.js"
    },
    "./style.css": "./dist/steptrack-core.css"
  },
  "files": ["dist"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript ../../server/openapi.json -o src/api/schema.d.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.4.0 || ^5.0.0",
    "pinia": "^3.0.0 || ^4.0.0",
    "vue-i18n": "^10.0.0 || ^11.0.0"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "oidc-client-ts": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "@zxing/browser": "^0.2.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor-mlkit/text-recognition": "^8.2.1",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "marked": "^17.0.0",
    "dompurify": "^3.3.0"
  },
  "devDependencies": {
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "pinia": "^4.1.0",
    "vue-i18n": "^11.4.16",
    "vite": "^8.3.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "vitest": "^5.0.5",
    "typescript": "~6.0.3",
    "vue-tsc": "^3.3.13",
    "fake-indexeddb": "^6.2.6",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "@types/node": "^22.0.0"
  }
}
