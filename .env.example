# Copy to .env (docker compose reads it; the server also reads server/.env when run directly).

# development | test | staging | production   (production refuses AUTH_MODE=dev)
ENV=development

# Postgres (docker compose)
POSTGRES_USER=steptrack
POSTGRES_PASSWORD=steptrack
POSTGRES_DB=steptrack
# Server, when run outside compose:
# DATABASE_URL=postgresql://steptrack:steptrack@localhost:5432/steptrack

# S3 / MinIO — blobs are stored content-addressed at blobs/<sha256>
S3_BUCKET=steptrack
S3_ACCESS_KEY=steptrack
S3_SECRET_KEY=steptrack-secret
# S3_ENDPOINT=http://localhost:9000   # omit for AWS S3
# S3_REGION=us-east-1
# S3_CREATE_BUCKET=false
BLOB_MAX_BYTES=26214400

# Auth: dev (Authorization: Dev <user-id>, seeded users) or oidc
AUTH_MODE=dev
# OIDC_ISSUER=https://id.example.com/realms/steptrack
# OIDC_AUDIENCE=steptrack-api
# OIDC_ROLES_CLAIM=roles            # dotted path allowed, e.g. realm_access.roles
# OIDC_JWKS_URL=                    # optional; discovered from the issuer otherwise

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Seed demo users (PIN 123456), procedure ASM-0001, workstations and tools on start
SEED_DEMO=true

# Lock / checkout tuning (seconds / hours)
# LOCK_TTL_SECONDS=120
# CHECKOUT_DEFAULT_HOURS=12
# CHECKOUT_MAX_HOURS=72
